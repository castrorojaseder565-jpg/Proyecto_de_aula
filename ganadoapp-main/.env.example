# Copia este archivo como .env y completa las credenciales del correo SMTP.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Reemplázala por el dominio HTTPS público donde está desplegada BoviControl.
APP_BASE_URL=https://app.example.com
# Para probar invitaciones en este equipo: APP_BASE_URL=http://localhost:8081 y true.
# En despliegues públicos debe permanecer false.
APP_ALLOW_LOCAL_URL=false

# Asistente conversacional con Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
